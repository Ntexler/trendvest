# TrendVest — Environment Variables
# Copy this to .env and fill in your values

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trendvest

# ── Reddit API ──
# Get credentials: https://www.reddit.com/prefs/apps
# Create "script" type app
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TrendVest/1.0

# ── NewsAPI ──
# Get free key: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key

# ── Claude AI ──
# Get API key: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Finnhub ──
# Get free key: https://finnhub.io/register (60 calls/min)
FINNHUB_API_KEY=your_finnhub_key

# ── Alpha Vantage ──
# Get free key: https://www.alphavantage.co/support/#api-key (25 calls/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ── FRED (Federal Reserve Economic Data) ──
# Get free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
